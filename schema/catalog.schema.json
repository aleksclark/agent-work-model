{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-work-model.dev/schema/catalog.json",
  "$comment": "Validates the catalog index that drives deterministic loading.",
  "title": "Agent Work Model Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "load", "term_keys", "systems", "conventions"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "license", "canonical_source", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "accepted"]
        },
        "license": {
          "type": "string"
        },
        "canonical_source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "rules", "mappings"],
      "properties": {
        "terms": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        },
        "mappings": {
          "type": "string"
        }
      }
    },
    "term_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_field_pattern",
        "prohibited_unqualified_fields",
        "runtime_field_name_patterns",
        "runtime_field_kinds",
        "credential_field_kinds",
        "no_runtime_state_terms",
        "immutable_terms",
        "exact_parent"
      ],
      "properties": {
        "identity_field_pattern": {
          "type": "string"
        },
        "prohibited_unqualified_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_field_name_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_field_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credential_field_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_runtime_state_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "immutable_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exact_parent": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "cardinality"],
            "properties": {
              "term": {
                "type": "string"
              },
              "cardinality": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
